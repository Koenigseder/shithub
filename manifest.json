{
  "manifest_version": 3,
  "name": "ShitHub",
  "version": "1.0.0",
  "description": "Renames GitHub to ShitHub and shows the real uptime percentage on every page.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*",
    "https://mrshu.github.io/github-statuses/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "ShitHub",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
